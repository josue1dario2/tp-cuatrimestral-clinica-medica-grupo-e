<configuration>
	<appSettings>
		<add key="cadenaConexion" value="server=.\SQLEXPRESS; database=CLINICA_DB; integrated security=true" />
	</appSettings>
	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" />
	</system.web>
	<system.webServer>
		<defaultDocument>
			<files>
				<clear />
				<add value="InicioAdmin.aspx" />
			</files>
		</defaultDocument>
	</system.webServer>
</configuration>
