<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="AdminRecep.Master.cs" Inherits="vista.AdminRecep" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Clínica - Gestión de Turnos</title>

    <!-- Google Fonts: Inter + Material Symbols (íconos del diseño) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <!-- Bootstrap 5.3.8 (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Estilos propios (siempre después de Bootstrap) -->
    <link href="~/Content/admin.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server" class="m-0 p-0">

        <!-- ===================== MENÚ LATERAL ===================== -->
        <aside class="sidebar-custom">
            <div class="d-flex flex-column">

                <!-- Marca -->
                <div class="sidebar-brand d-flex align-items-center gap-2 px-3">
                    <div class="sidebar-brand-icon d-flex align-items-center justify-content-center text-white rounded-3 shadow-sm">
                        <span class="material-symbols-outlined icon-22">local_hospital</span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="sidebar-brand-title fw-semibold text-white tracking-tight">Clínica</span>
                        <span class="sidebar-brand-subtitle fw-normal">Gestión de Turnos</span>
                    </div>
                </div>

                <!-- Navegación (la clase "active" se asigna desde el code-behind según la página actual) -->
                <div class="px-2 py-2">
                    <nav class="d-flex flex-column gap-1">
                        <asp:HyperLink ID="lnkNavInicio" runat="server" NavigateUrl="~/InicioAdmin.aspx" CssClass="nav-item-custom">
                            <span class="material-symbols-outlined">grid_view</span>
                            <span>Inicio</span>
                        </asp:HyperLink>
                        <asp:HyperLink ID="lnkNavTurnos" runat="server" NavigateUrl="~/Turnos.aspx" CssClass="nav-item-custom">
                            <span class="material-symbols-outlined">calendar_month</span>
                            <span>Turnos</span>
                        </asp:HyperLink>
                        <asp:HyperLink ID="lnkNavNuevoTurno" runat="server" NavigateUrl="~/NuevoTurno.aspx" CssClass="nav-item-custom">
                            <span class="material-symbols-outlined">add_circle</span>
                            <span>Nuevo Turno</span>
                        </asp:HyperLink>
                        <asp:HyperLink ID="lnkNavPacientes" runat="server" NavigateUrl="~/Pacientes.aspx" CssClass="nav-item-custom">
                            <span class="material-symbols-outlined">personal_injury</span>
                            <span>Pacientes</span>
                        </asp:HyperLink>
                        <asp:HyperLink ID="lnkNavMedicos" runat="server" NavigateUrl="~/Medicos.aspx" CssClass="nav-item-custom">
                            <span class="material-symbols-outlined">stethoscope</span>
                            <span>Médicos</span>
                        </asp:HyperLink>

                        <%-- Sección solo para el Administrador: ocultar con phMenuAdministracion.Visible = false para Recepción --%>
                        <asp:PlaceHolder ID="phMenuAdministracion" runat="server">
                            <div class="my-2 px-3 pt-1">
                                <span class="nav-section-title text-uppercase fw-semibold">Administración</span>
                            </div>
                            <asp:HyperLink ID="lnkNavEspecialidades" runat="server" NavigateUrl="~/Especialidades.aspx" CssClass="nav-item-custom">
                                <span class="material-symbols-outlined">clinical_notes</span>
                                <span>Especialidades</span>
                            </asp:HyperLink>
                            <asp:HyperLink ID="lnkNavTurnosTrabajo" runat="server" NavigateUrl="~/TurnosTrabajo.aspx" CssClass="nav-item-custom">
                                <span class="material-symbols-outlined">schedule</span>
                                <span>Turnos de Trabajo</span>
                            </asp:HyperLink>
                            <asp:HyperLink ID="lnkNavUsuarios" runat="server" NavigateUrl="~/GestionUsuariosAdmin.aspx" CssClass="nav-item-custom">
                                <span class="material-symbols-outlined">manage_accounts</span>
                                <span>Usuarios</span>
                            </asp:HyperLink>
                            <asp:HyperLink ID="lnkNavEstadisticas" runat="server" NavigateUrl="~/Estadisticas.aspx" CssClass="nav-item-custom">
                                <span class="material-symbols-outlined">analytics</span>
                                <span>Estadísticas</span>
                            </asp:HyperLink>
                        </asp:PlaceHolder>
                    </nav>
                </div>
            </div>

            <!-- Pie del menú -->
            <div class="sidebar-footer p-3">
                <div class="sidebar-footer-box d-flex align-items-center justify-content-between px-3 py-2 rounded-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="status-dot-online"></span>
                        <span>Sistema Operativo</span>
                    </div>
                    <span>v2.4</span>
                </div>
            </div>
        </aside>

        <!-- ===================== BARRA SUPERIOR ===================== -->
        <header class="topbar-custom d-flex align-items-center justify-content-between px-4">

            <!-- Fecha y búsqueda global -->
            <div class="d-flex align-items-center gap-3">
                <div class="topbar-date d-flex align-items-center gap-2 px-3 py-1 rounded-3 text-secondary">
                    <span class="material-symbols-outlined icon-18">calendar_today</span>
                    <asp:Label ID="lblFechaHoy" runat="server" Text="Hoy, 24 de mayo 2025"></asp:Label>
                </div>
                <asp:Panel ID="pnlBuscarGlobal" runat="server" DefaultButton="btnBuscarGlobal"
                    CssClass="topbar-search d-none d-md-flex align-items-center position-relative">
                    <span class="topbar-search-icon material-symbols-outlined icon-18 position-absolute text-secondary">search</span>
                    <asp:TextBox ID="txtBuscarGlobal" runat="server" CssClass="topbar-search-input form-control form-control-sm ps-5 rounded-3 border-0"
                        placeholder="Buscar turno, DNI..."></asp:TextBox>
                    <%-- Botón oculto: permite buscar con Enter (DefaultButton del Panel) --%>
                    <asp:Button ID="btnBuscarGlobal" runat="server" OnClick="btnBuscarGlobal_Click" CausesValidation="false" CssClass="d-none" Text="Buscar" />
                </asp:Panel>
            </div>

            <!-- Usuario logueado y cierre de sesión -->
            <div class="d-flex align-items-center gap-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex flex-column text-end">
                        <asp:Label ID="lblNombreUsuario" runat="server" CssClass="topbar-user-name fw-semibold text-dark" Text="María González"></asp:Label>
                        <div>
                            <asp:Label ID="lblRolUsuario" runat="server" CssClass="topbar-user-role badge rounded-pill" Text="Administradora / Recepción"></asp:Label>
                        </div>
                    </div>
                    <div class="topbar-user-avatar d-flex align-items-center justify-content-center text-white rounded-circle shadow-sm">
                        <span class="material-symbols-outlined icon-18">person</span>
                    </div>
                </div>
                <asp:LinkButton ID="btnCerrarSesion" runat="server" OnClick="btnCerrarSesion_Click" CausesValidation="false"
                    CssClass="btn-logout btn btn-sm d-flex align-items-center gap-1 text-secondary border-0 p-1 px-2 rounded-2">
                    <span class="material-symbols-outlined icon-18">logout</span>
                    <span>Cerrar sesión</span>
                </asp:LinkButton>
            </div>
        </header>

        <!-- ===================== CONTENIDO DE CADA PÁGINA ===================== -->
        <main class="main-wrapper">
            <div class="main-container container-fluid px-4 py-4">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </main>
    </form>

    <!-- Bootstrap 5.3.8 JS Bundle (incluye Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scripts propios de cada página -->
    <asp:ContentPlaceHolder ID="Scripts" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
